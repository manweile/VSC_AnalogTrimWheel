{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug with Atmel-ICE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/arduino.avr.promicro/${fileBasename}.elf",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            // or "miDebuggerPath": "${env:ARDUINO_TOOLS}\\avr-gcc\\7.3.0-atmel3.6.1-arduino5\\bin\\avr-gdb.exe",
            "miDebuggerPath": "${env:ARDUINO_TOOLS}\\avr-gcc\\7.3.0-atmel3.6.1-arduino5\\bin\\avr-gdb.exe",
            "miDebuggerServerAddress": "localhost:4242", // Default port for OpenOCD GDB server
            // "targetArchitecture": "arm",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                },
                {
                    "description": "Reset and halt target",
                    "text": "monitor reset halt",
                    "ignoreFailures": false
                }
            ]
            //"preLaunchTask": "build_project" // Optional: runs the build task before debugging
        }
    ]
}

{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        //  in WSL Ubuntu terminal: avarice --edbg --jtag usb :4242
        // in Admin Powershell terminal: avr-gdb.exe -iex "target remote localhost:4242" VSC_AnalogTrimWheel.ino.elf
        {
            "name": "AVR Remote Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.elf",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\AVR\\avr8-gnu-toolchain\\bin\\avr-gdb.exe",
            "miDebuggerServerAddress": "localhost:4242",
            "logging": {
                "engineLogging": true
            },
            "stopAtEntry": false,
            "externalConsole": false,
        }
    ],
    "inputs": [
        {
            // list of FQBN for the boards I have and are installed in arduino-cli
            "type": "pickString",
            "id": "FQBNDIR",
            "description": "Fully Qualified Board Name (FQBN)build directory to use",
            "options": [
                "arduino.avr.mega",
                "arduino.avr.micro",
                "arduino.avr.promicro",
                "arduino.avr.uno",
                // "esp32.esp32.esp32thing",
                // "esp8266.esp8266.thingdev",
                "SparkFun.avr.promicro",
            ]
        },
        {
            // dynamic com port list from google search: vs code tasks.json input com ports extension "Command Variable"
            "id": "COMPort",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                // alternative windows only command: "powershell -Command \"[System.IO.Ports.SerialPort]::GetPortNames()\""
                "command": "python ${workspaceFolder}/list_ports.py",
                "description": "Select the COM port for upload"
            }
        }
    ]
}

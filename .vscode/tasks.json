        //     "args": [
        //         "-c", "source [find interface/cmsis-dap.cfg]",
        //         "-c", "set CHIPNAME ${input:MCU}",
        //         "-c", "source [find target/${input:MCU}.cfg]",
        //         "-c", "init",

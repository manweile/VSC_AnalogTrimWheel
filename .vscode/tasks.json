        // proven to work
        // from google search AI: VS Code tasks.json for MSYS shell running avarice fro avarice installed/usr/bin directory
        // in MYSYS2 MYS terminal at C:\msys64\home\Gerald\avarice\avarice_installed\usr\bin : ./avarice --edbg --jtag usb :4242
            {
            "label": "MYSYS Bash AVaRICE Server",
            "type": "shell",
            "command": "avarice",
            "options": {
                "shell": {
                    "executable": "C:/msys64/usr/bin/bash.exe",
                    "args": [
                        "--login",
                        "-c",
                        "C:/msys64/home/Gerald/avarice/avarice_installed/usr/bin/avarice --edbg --jtag usb :4242"
                    ]
                },
                "env": {
                    "MSYSTEM": "MSYS",
                    "CHERE_INVOKING": "1"
                }
            },
            "problemMatcher": [],
            "group": "none"
        },
        // also proven to work
        // in MYSYS2 MYS terminal at C:\msys64\home\Gerald\avarice\avarice_installed\usr\bin : ./avarice --edbg --jtag usb :4242
        {
            "label": "MYSYS Shell AVaRICE Server",
            "type": "shell",
            "command": "C:/msys64/msys2_shell.cmd", 
            "args": [
                "-shell",
                "bash",
                "-c",
                "C:/msys64/home/Gerald/avarice/avarice_installed/usr/bin/avarice --edbg --jtag usb :4242" 
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // not as useful due to usbpid steps that have to be executed manually
        // in WSL Ubuntu terminal: <user>@<computer>:~$ avarice --edbg --jtag usb :4242
        {
            "label": "WSL Ubuntu AVaRICE Server",
            "type": "shell",
            "command": "avarice",
            "args": [
                // Replace "avarice [options]" with your specific avarice command
                "--edbg", "--jtag", "usb", ":4242"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        // all arduino-cli tasks require arduino-cli path in User and/or System PATH
        // and a properly configured & located arduino-cli.yaml file
        // arduino-cli compile -v --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-CLI Production File Compile",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "-v",
                "--clean",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // upload a production (hex) file
        // board MUST HAVE BOOTLOADER
        // arduino-cli upload  -v -p COM26 --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-CLI Production File COM Port Upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "-v",
                "-p",
                "${input:COMPort}",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // compile and upload a production (hex) file
        // board MUST HAVE BOOTLOADER
        // arduino-cli compile --upload  -v -p COM26 --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-CLI Production File Compile & COM Port Upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--upload",
                "-v",
                "-p",
                "${input:COMPort}",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // compile a debug (elf) file
        // arduino-cli compile --clean -v --fqbn arduino:avr:promicro --build-property 'compiler.c.extra_flags=-g3 -Og' --build-property 'compiler.cpp.extra_flags=-g3 -Og' "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-CLI Debug File Compile",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--clean",
                "-v",
                "--fqbn",
                "${input:FQBN}",
                "--build-property",
                "compiler.c.extra_flags=-g3 -Og",
                "--build-property",
                "compiler.cpp.extra_flags=-g3 -Og",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // upload a debug (elf) file 
        // board MUST HAVE BOOTLOADER
        // arduino-cli upload  -v -p COM24 --fqbn arduino:avr:micro --input-file "D:\MyArduino\Projects\VSC_AnalogTrimWheel\build\arduino.avr.micro\VSC_AnalogTrimWheel.ino.elf"
        {
            "label": "Arduino-CLI Debug File COM Port Upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "-v",
                "-p",
                "${input:COMPort}",
                "--fqbn",
                "${input:FQBN}",
                "-i",
                "${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.elf"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // arduino-cli can not compile & upload elf file in single command line
        {
            "label": "Arduino-CLI Debug Compile & COM Port Upload",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Arduino-CLI Debug File Compile",
                "Arduino-CLI Debug File COM Port Upload"
            ],
            "problemMatcher": []
        },
        // all avrdude tasks require avrdude path in User and/or System PATH
        // functionally equivalent to Arduino-CLI elf file COM port upload, but for use when bootloader NOT on arduino board and Atmel_ICE hooked up to ISP
        // avrdude -v -p atmega32u4 -c atmelice_isp -P usb -U flash:w:D:\MyArduino\Projects\VSC_AnalogTrimWheel\build\arduino.avr.micro\VSC_AnalogTrimWheel.ino.elf:e
        {
            "label": "Avrdude Atmel-ICE Debug File Upload",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-v",
                "-p${input:MCU}",
                "-c", "${input:TARGET}",
                "-P", "usb",
                "-U","flash:w:${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.elf:e"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // functionally equivalent to Arduino-CLI hex file COM port upload, but for use when bootloader NOT on arduino board and Atmel_ICE hooked up to ISP
        // avrdude -v -p atmega32u4 -c atmelice_isp -P usb -U flash:w:D:\MyArduino\Projects\VSC_AnalogTrimWheel\build\arduino.avr.micro\VSC_AnalogTrimWheel.ino.hex:i
        {
            "label": "Avrdude Atmel-ICE Production File Upload",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-v",
                "-p${input:MCU}",
                "-c", "${input:TARGET}",
                "-P", "usb",
                "-U","flash:w:${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.hex:i"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // restores choosen bootloader and Atmel_ICE hooked up to ISP
        // avrdude -v -p atmega32u4 -c atmelice_isp -F -U flash:w:"C:\Users\gmanw\AppData\Local\arduino15\packages\arduino\hardware\avr\1.8.2\bootloaders\caterina\Caterina-Micro.hex":i 
        {
            "label": "Avrdude Atmel-ICE Restore Bootloader",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-v",
                "-p${input:MCU}",
                "-c", "${input:TARGET}",
                "-F",
                "-U","flash:w:${input:openDialog}:i"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        // list of avr mcu's for the boards I have installed
        {
            "type": "pickString",
            "id": "MCU",
            "description": "AVR mcu for upload",
            "options": [
                "atmega32u4",       // Micro, Pro Micro
                "atmega328p",       // Uno
                "atmega2560"        // Mega 2560
            ]
        },
        // list of atmel ice connection targets
        {
            "type": "pickString",
            "id": "TARGET",
            "description": "Atmel-ICE target for upload",
            "options": [
                "atmelice_isp",   // 6 pin ISP
                "atmelice"        // 10 pin JTAG
            ]
        },
        // list of FQBN for the boards I have and are installed in arduino-cli
        {
            "type": "pickString",
            "id": "FQBN",
            "description": "Fully Qualified Board Name (FQBN) to use",
            "options": [
                "arduino:avr:mega",
                "arduino:avr:micro",
                "arduino:avr:promicro",
                "arduino:avr:uno",
                "SparkFun:avr:promicro",
            ]
        },
        // list of build dirs for the FQBN of boards I have and are installed in arduino-cli
        {
            "type": "pickString",
            "id": "FQBNDIR",
            "description": "Fully Qualified Board Name (FQBN) build directory to use",
            "options": [
                "arduino.avr.mega",
                "arduino.avr.micro",
                "arduino.avr.promicro",
                "arduino.avr.uno",
                "SparkFun.avr.promicro",
            ]
        },
        // dynamic com port list from google search: vs code tasks.json input com ports extension "Command Variable"
        {
            "id": "COMPort",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                // alternative windows only command: "powershell -Command \"[System.IO.Ports.SerialPort]::GetPortNames()\""
                "command": "python ${workspaceFolder}/list_ports.py",
                "description": "Select the COM port for upload"
            }
        },
        // open a file dialog in arduino hardware bootloaders directory
        {
            "id": "openDialog",
            "type": "command",
            "command": "extension.commandvariable.file.openDialog",
            "args": {
                "canSelect": "files",
                "defaultUri": "${env:ARDUINO_HARDWARE_BOOTLOADERS}",
                "include": "**/*.hex",
                "filters": {
                    "Hex": ["hex"]
                }
            }
        }
    ]
}

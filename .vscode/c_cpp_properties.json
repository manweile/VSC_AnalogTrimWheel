{
    "configurations": [
        {
            "name": "Pro Micro Win",
            "includePath": [
                "${workspaceFolder}/**",
                // project sapecific libaries are in D:\MyArduino\Projects\Libraries\
                "${env:ARDUINO_LIBRARIES}/ResponsiveAnalogRead/src",
                "${env:ARDUINO_LIBRARIES}/ArduinoJoystick/src",
                "${env:ARDUINO_LIBRARIES}/ArduinoJoystick/src/DynamicHID",
                // arduino hardware libraries are in C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\hardware\avr\1.8.2\libraries
                "${env:ARDUINO_HARDWARE_LIBRARIES}/EEPROM",
                "${env:ARDUINO_HARDWARE_LIBRARIES}/HID",
                "${env:ARDUINO_HARDWARE_LIBRARIES}/SoftwareSerial",
                "${env:ARDUINO_HARDWARE_LIBRARIES}/SPI",
                "${env:ARDUINO_HARDWARE_LIBRARIES}/Wire",
                // arduino hardware cores are in C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\hardware\avr\1.8.2\cores
                "${env:ARDUINO_HARDWARE_CORES}/arduino/**",
                // arduino hardware variants are in C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\hardware\avr\1.8.2\variants
                "${env:ARDUINO_HARDWARE_VARIANTS}/**",
                // arduin tools are in C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\tools
                "${env:ARDUINO_TOOLS}/avr-gcc/**/**"
            ],
            "defines": [
                "_DEBUG",
                "UNICODE",
                "_UNICODE",
                "ARDUINO=108010",           // Arduino IDE, required by Joystick.h
                "F_CPU=16000000L",          // Clock speed for Pro Micro (Leonardo) & Micro
                "ARDUINO_AVR_MICRO",        // enable correct intellisense for Pro Micro
                "__AVR__",                  // specify AVR mcu architecture
                "__AVR_ATmega32U4__",       // MCU for Pro Micro (Leonardo) & Micro, upper case spelling
                "__AVR_ATmega32u4__",       // MCU for Pro Micro (Leonardo) & Micro, lower case spelling
                "ARDUINO_ARCH_AVR",         // specify arch to get corect libaray debug output ie Serial for AVR
                "USBCON"                    // required by Joystick.h
            ],
            "compilerPath": "${env:ARDUINO_TOOLS}/avr-gcc/7.3.0-atmel3.6.1-arduino5/bin/avr-gcc.exe",
            "cStandard": "c17",
            "cppStandard": "c++17",
            "intelliSenseMode": "gcc-x64"
        }
    ],
    "version": 4
}
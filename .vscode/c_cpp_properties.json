{
    "configurations": [
        {
            "name": "AVR",
            "includePath": [
                "${workspaceFolder}/**",
                // D:\MyArduino\Projects\Libraries\ArduinoJoystick\src\**
                "${env:ARDUINO_LIBRARIES}/ArduinoJoystick/src/**",
                // D:\MyArduino\Projects\Libraries\ArduinoJoystick\src\DynamicHID\**
                "${env:ARDUINO_LIBRARIES}/ArduinoJoystick/src/DynamicHID",
                // D:\MyArduino\Projects\Libraries\ResponsiveAnalogRead\src\**
                "${env:ARDUINO_LIBRARIES}/ResponsiveAnalogRead/src",
                // C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\hardware\avr\1.8.2\cores\arduino\**
                "${env:ARDUINO_HARDWARE_CORES}/arduino/**",
                // C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\hardware\avr\1.8.2\variants\**
                "${env:ARDUINO_HARDWARE_VARIANTS}/**",
                // C:\Users\gmanw\AppData\Local\Arduino15\packages\arduino\tools\avr-gcc\**\**
                "${env:ARDUINO_TOOLS}/avr-gcc/**/**"
            ],
            "intelliSenseMode": "${default}",
            // "compilerPath": "C:/Users/gmanw/AppData/Local/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino5/bin/avr-gcc.exe",
            "compilerPath": "${env:ARDUINO_TOOLS_AVRGCC_BIN}/avr-gcc.exe",
            "cStandard": "${default}",
            "cppStandard": "${default}",
            "compilerArgs": [
                "-g",
                "-Os",
                "-Wall",
                "-Wextra",
                "-fpermissive",
                "-fno-exceptions",
                "-fno-threadsafe-statics",
                "-ffunction-sections",
                "-fdata-sections",
                "-pipe",
                "-mmcu=atmega32u4",
                "-DF_CPU=16000000UL"
            ]
        }
    ],
    "version": 4
}
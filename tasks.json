{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        // leaving this in for eventual SAM mcu usage
        // openocd -f interface/cmsis-dap.cfg -c "set CHIPNAME atmega32u4" -c "source [find target/atmega32u4.cfg]" -c "init" -c "reset halt"
        {
            "label": "Win OpenOCD Server",
            "type": "process",
            "command": "openocd",
            "args": [
                "-c", "source [find interface/cmsis-dap.cfg]",
                "-c", "set CHIPNAME ${input:MCU}",
                "-c", "source [find target/${input:MCU}.cfg]",
                "-c", "init",
                "-c", "reset halt"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "new",
                "reveal": "always"
            }
        },
        // in MYSYS2 MYS terminal at C:\msys64\home\Gerald\avarice\avarice_installed\usr\bin : ./avarice --edbg --jtag usb :4242
        {
            "label": "MYSYS AVaRICE Server",
            "type": "shell",
            "command": "C:/msys64/msys2_shell.cmd", 
            "args": [
                "-defterm",
                "-no-start",
                "-shell",
                "bash",
                "-c",
                "/usr/bin/avarice --edbg --jtag usb :4242" 
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // in WSL Ubuntu terminal: <user>@<computer>:~$ avarice --edbg --jtag usb :4242
        {
            "label": "WSL Ubuntu AVaRICE Server",
            "type": "shell",
            "command": "avarice",
            "args": [
                // Replace "avarice [options]" with your specific avarice command
                "--edbg", "--jtag", "usb", ":4242"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        },
        // all arduino-cli tasks require arduino-cli path in User and/or System PATH
        // and a properly configured & located arduino-cli.yaml file
        // arduino-cli compile -v --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-cli production compile only",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "-v",
                "--clean",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // arduino-cli compile --clean --fqbn arduino:avr:promicro --build-property compiler.c.extra_flags=-Og --build-property compiler.cpp.extra_flags=-Og "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-cli debug compile only",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--clean",
                "-v",
                "--fqbn",
                "${input:FQBN}",
                "--build-property",
                "compiler.c.extra_flags=-g3 -Og",
                "--build-property",
                "compiler.cpp.extra_flags=-g3 -Og",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // arduino-cli upload  -v -p COM26 --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-cli COM Port upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "-v",
                "-p",
                "${input:COMPort}",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // arduino-cli compile --upload  -v -p COM26 --fqbn arduino:avr:promicro "D:\MyArduino\Projects\VSC_AnalogTrimWheel"
        {
            "label": "Arduino-cli production compile & COM port upload",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--upload",
                "-v",
                "-p",
                "${input:COMPort}",
                "--fqbn",
                "${input:FQBN}",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // all avrdude tasks require avrdude path in User and/or System PATH
        // avrdude -v -p atmega32u4 -c atmelice_isp -P usb -U flash:w:D:\MyArduino\Projects\VSC_AnalogTrimWheel\build\arduino.avr.micro\VSC_AnalogTrimWheel.ino.elf:e
        {
            "label": "Avrdude Atmel-ICE elf upload",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-v",
                "-p${input:MCU}",
                "-c", "${input:TARGET}",
                "-P", "usb",
                "-U","flash:w:${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.elf:e"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        // avrdude -v -p atmega32u4 -c atmelice_isp -P usb -U flash:w:D:\MyArduino\Projects\VSC_AnalogTrimWheel\build\arduino.avr.micro\VSC_AnalogTrimWheel.ino.hex:i
        {
            "label": "Avrdude Atmel-ICE hex upload",
            "type": "shell",
            "command": "avrdude",
            "args": [
                "-v",
                "-p${input:MCU}",
                "-c", "${input:TARGET}",
                "-P", "usb",
                "-U","flash:w:${workspaceFolder}/build/${input:FQBNDIR}/${fileBasename}.hex:i"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        // list of avr mcu's for the boards I have installed
        {
            "type": "pickString",
            "id": "MCU",
            "description": "AVR mcu for upload",
            "options": [
                "atmega32u4",       // Micro, Pro Micro
                "atmega328p",       // Uno
                "atmega2560"        // Mega 2560
            ]
        },
        // list of atmel ice connection targets
        {
            "type": "pickString",
            "id": "TARGET",
            "description": "Atmel-ICE target for upload",
            "options": [
                "atmelice_isp",   // 6 pin ISP
                "atmelice"        // 10 pin JTAG
            ]
        },
        {
            // list of FQBN for the boards I have and are installed in arduino-cli
            "type": "pickString",
            "id": "FQBN",
            "description": "Fully Qualified Board Name (FQBN) to use",
            "options": [
                "arduino:avr:mega",
                "arduino:avr:micro",
                "arduino:avr:promicro",
                "arduino:avr:uno",
                "SparkFun:avr:promicro",
            ]
        },
        {
            // list of build dirs for the FQBN of boards I have and are installed in arduino-cli
            "type": "pickString",
            "id": "FQBNDIR",
            "description": "Fully Qualified Board Name (FQBN) build directory to use",
            "options": [
                "arduino.avr.mega",
                "arduino.avr.micro",
                "arduino.avr.promicro",
                "arduino.avr.uno",
                "SparkFun.avr.promicro",
            ]
        },
        {
            // dynamic com port list from google search: vs code tasks.json input com ports extension "Command Variable"
            "id": "COMPort",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                // alternative windows only command: "powershell -Command \"[System.IO.Ports.SerialPort]::GetPortNames()\""
                "command": "python ${workspaceFolder}/list_ports.py",
                "description": "Select the COM port for upload"
            }
        }
    ]
}
